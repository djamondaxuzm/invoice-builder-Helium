{
  "name": "invoice-builder",
  "private": true,
  "version": "2.8.1",
  "type": "module",
  "description": "Invoice and quotation builder desktop app with PDF export, designed for small businesses and freelancers. Create, manage, and export invoices and quotes easily using a local database in an Electron-based app.",
  "author": "djamondaxuzm",
  "keywords": [
    "invoice",
    "quotation",
    "quote",
    "billing",
    "pdf-export",
    "pdf-generation",
    "business-management",
    "finance",
    "accounting",
    "desktop-app",
    "electron",
    "local-database",
    "invoice-builder",
    "quotation-builder",
    "billing-software",
    "business-software",
    "document-generation"
  ],
  "bugs": {
    "url": "https://github.com/djamondaxuzm/invoice-builder-Helium/issues"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/djamondaxuzm/invoice-builder-Helium.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "npm run dev:clean:backend && concurrently \"npm:dev:react\" \"npm:dev:preload\" \"npm:dev:migrations\" \"npm:dev:electron\" \"npm:dev:electron:start:wait\"",
    "dev:clean:backend": "rimraf dist-be/backend",
    "dev:webserver": "set TS_NODE_PROJECT=tsconfig.webserver.json && npx tsx --watch src/backend/webserver/main.ts",
    "dev:fe": "concurrently \"npm:dev:react\" \"npm:dev:preload\" \"npm:dev:migrations\"",
    "dev:preload": "vite build --config vite.preload.config.ts --watch",
    "dev:react": "vite",
    "dev:electron:start:wait": "wait-on dist-be/backend/main/main.cjs && npm run dev:electron:start",
    "dev:electron:start": "electronmon dist-be/backend/main/main.cjs --exit",
    "dev:electron": "vite build --config vite.electron.config.ts --watch",
    "dev:migrations": "vite build --config vite.migrations.config.ts --watch",
    "build": "npm run build:react && npm run build:preload && npm run build:migrations && npm run build:electron",
    "build:webserver": "tsc -p tsconfig.webserver.json && node scripts/copy-webserver-package.js",
    "build:fe": "npm run build:react && npm run build:preload && npm run build:migrations && npm run build:webserver",
    "build:react": "vite build",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:migrations": "vite build --config vite.migrations.config.ts",
    "build:electron": "vite build --config vite.electron.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest --coverage",
    "sort:i18n": "node scripts/sort-i18n.js",
    "package": "node scripts/build-installer.mjs --win",
    "release:win": "node scripts/build-installer.mjs --win --publish always",
    "release:mac": "node scripts/build-installer.mjs --mac --publish always",
    "postinstall": "electron-builder install-app-deps",
    "test:packaged": "playwright test --config playwright.packaged.config.ts",
    "package:mac": "node scripts/build-installer.mjs --mac"
  },
  "dependencies": {
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@electron/rebuild": "^4.0.4",
    "@emotion/jest": "^11.14.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^9.39.2",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-date-pickers": "^9.7.0",
    "@playwright/test": "^1.63.0",
    "@react-pdf/renderer": "^4.5.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.4.0",
    "@types/pako": "^3.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/redux-mock-store": "^1.5.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.0",
    "baseline-browser-mapping": "^2.10.20",
    "buffer": "^5.7.1",
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.21",
    "dotenv": "^17.3.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.8.1",
    "electron-updater": "^6.8.3",
    "electronmon": "^2.0.4",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "file-saver": "^2.0.5",
    "globals": "^17.7.0",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "jsdom": "^30.0.1",
    "msw": "^2.12.14",
    "mui-color-input": "^9.0.0",
    "multer": "^2.3.0",
    "pako": "^3.0.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "prettier": "^3.9.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-error-boundary": "^6.1.1",
    "react-i18next": "^17.0.13",
    "react-image-crop": "^11.1.2",
    "react-number-format": "^5.4.5",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.3",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "recharts": "^3.8.0",
    "redux-mock-store": "^1.5.5",
    "sort-json": "^2.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "uuid": "^14.0.0",
    "vite": "^8.3.0",
    "vite-plugin-static-copy": "^4.1.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0",
    "wait-on": "^9.0.5",
    "web-vitals": "^6.1.0"
  },
  "msw": {
    "workerDirectory": "public"
  },
  "overrides": {
    "tar": "^7.5.9",
    "minimatch": "^10.2.1",
    "dompurify": "^3.4.13",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
